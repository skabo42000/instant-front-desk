MODEL_MODE=
# Local browser chat is offline unless explicitly enabled. It uses only eval keys below.
LOCAL_CHAT_MODE=fake
# Set yes only after confirming BOTH accounts are Free with paid billing disabled.
# This is a manual account check, not an API billing guarantee.
FREE_TIER_CONFIRMED=
# Shared across embeddings, answer retries and fallbacks; local = process cap, pilot = persistent cap.
# Stops at the cap or first quota response. A pilot restart never replenishes the persistent cap.
LOCAL_CHAT_MAX_CALLS=60
# Optional alternative local DB folder (preserves the default database).
IFD_DATABASE_DIR=
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_EVAL_API_KEY=
GROQ_API_KEY=
# Real evaluation adapters use only these isolated evaluation keys.
# Gemini evaluation key is above; never reuse the existing widget key.
GROQ_EVAL_API_KEY=
# Model defaults verified live 2026-10-10, may change.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Ordered Gemini text fallback models; empty disables fallback.
GEMINI_TEXT_FALLBACK_MODELS=
# Optional older overrides take precedence over GEMINI_TEXT_MODEL.
GEMINI_ANSWER_MODEL=
# Optional: when omitted, questions use GEMINI_ANSWER_MODEL.
GEMINI_QUESTION_MODEL=
GROQ_MODEL=openai/gpt-oss-120b
# Embeddings stay gemini-embedding-001; every request explicitly asks for 768
# dimensions (verified live 2026-10-10). The provider default is 3072.

# Local only: memory. A pilot requires matching supabase or postgres stores and fails closed.
RATE_LIMIT_STORE=memory
IFD_DATA_STORE=local
# Dedicated Mac pilot role only; generated by npm run live-db -- init. Never use the owner at runtime.
IFD_DATABASE_URL=
# Mac live script forces ~/ifd-postgres/provider-stop (outside OneDrive).
IFD_PROVIDER_STOP_DIR=
# Prepared controlled pilot; leave disabled until docs/pilot.md gates pass.
IFD_PILOT_MODE=no
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PILOT_ACCESS_TOKEN=
PILOT_PUBLIC_ORIGIN=
PILOT_BUSINESS_IDS=
PILOT_BENCHMARK_HASHES=
PILOT_ACCEPTANCE_CONFIRMED=
PILOT_PAUSED=

# Optional LOCAL read-only MCP API; disabled in pilot mode. Never commit a real token.
IFD_MCP_ENABLED=no
IFD_MCP_ORIGIN=http://127.0.0.1:3000
IFD_MCP_TOKEN=
IFD_MCP_BUSINESS_IDS=
